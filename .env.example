# Aktifkan hanya untuk preview data contoh (true). Default produksi adalah false (mode pra-launch jujur).
NEXT_PUBLIC_DEMO_MODE=false

# Kunci rahasia penandatanganan cookie sesi HMAC-SHA256 (minimal 16 karakter acak).
AUTH_SESSION_SECRET=ganti_dengan_kunci_rahasia_acak_minimal_32_karakter_di_produksi

# Masa aktif sesi dalam hari (default: 30 hari). Atur misal 30, 60, atau 90 hari agar sesi bertahan lama tanpa perlu login berulang kali.
AUTH_SESSION_MAX_AGE_DAYS=30

# Konfigurasi Basis Data Supabase
# Ambil dari: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
APP_URL=https://domain-anda.id

# Kode Akses Masuk Pengurus / Admin (PIN atau kata sandi pengurus)
ADMIN_PASSKEY=ganti_dengan_kata_sandi_panjang_acak_minimal_16_karakter
